# Atlas / Ayra — Fase 1
#
# Copie para .env e EDITE. O .env NUNCA vai para o git.
ATLAS_ENV=dev
ATLAS_DATABASE_PATH=./data/atlas.db

# ---------------------------------------------------------------------------
# LLM — escolha UM dos dois caminhos:
#
#   fake   -> roda sem chave e sem internet. Use isto para desenvolver.
#   gemini -> precisa de chave real do Google AI Studio (começa com "AIza").
# ---------------------------------------------------------------------------
ATLAS_LLM_PROVIDER=fake

ATLAS_GEMINI_API_KEY=
ATLAS_GEMINI_MODEL=gemini-2.5-flash
ATLAS_GEMINI_EMBED_MODEL=gemini-embedding-001

# Auth — Fase 0/1: token estático (opcional em dev).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
ATLAS_API_TOKEN=
ATLAS_USER_ID=caio
# Uso solo no Render: 1 = libera sem colar token no browser (quem tiver a URL entra)
ATLAS_OPEN_ACCESS=0

# Consolidação: a cada quantos turnos a conversa vira memória permanente.
# Free tier tem pouca cota — 6 é um bom equilíbrio. Use 2 se quiser testar rápido.
ATLAS_CONSOLIDATE_EVERY=6
